{
    "name": "blog-groupe-4/vercel",
    "description": "Blog et forum du Groupe 4 - Version Vercel",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "includes/"
        }
    },
    "config": {
